{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/)",
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('host').val() === auth.uid))",

        "host": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },

        "state": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'playing')"
        },
        "duration": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && (newData.val() === 60 || newData.val() === 120 || newData.val() === 300)"
        },
        "round": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000"
        },
        "seed": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "startedAt": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name']) && newData.parent().numChildren() <= 8 && (data.exists() || newData.parent().parent().child('state').val() === 'lobby')",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "scores": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "$round.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['name', 'score', 'done'])",
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14" },
              "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
              "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
              "done": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
